# Used by docker-compose.yml. Copy to .env and fill in before `docker compose up`.

POSTGRES_USER=career_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=career_intelligence

JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables the AI advice / career assistant endpoints
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Baked into the frontend at build time (Next.js public env vars are
# inlined at build, not read at runtime) — rebuild the frontend image
# if you change this.
NEXT_PUBLIC_API_URL=http://localhost:8000
